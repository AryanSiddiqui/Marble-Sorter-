{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain\nbrain = Brain()\n\n# Sensors\nline_tracker_b = Line(brain.three_wire_port.b)\ndistance_1 = Distance(Ports.PORT1)\n\n# Wait for sensors\nwait(30, MSEC)\n\n# Random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = (\n        brain.battery.voltage(MV)\n        + brain.battery.current(CurrentUnits.AMP) * 100\n        + brain.timer.system_high_res()\n    )\n    urandom.seed(int(random))\n\ninitializeRandomSeed()\n\nwait(200, MSEC)\nprint(\"\\033[2J\")\n#endregion\n\n\n# =========================\n# LIGHTING CALIBRATION\n# =========================\n\nBASE_REF = 0\n\ndef calibrate_light():\n\n    global BASE_REF\n\n    total = 0\n    samples = 25\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Calibrating...\")\n\n    wait(300, MSEC)\n\n    for _ in range(samples):\n\n        total += line_tracker_b.reflectivity(PERCENT)\n        wait(15, MSEC)\n\n    BASE_REF = total / samples\n\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"BASE REF:\")\n    brain.screen.print(round(BASE_REF, 1))\n\n    wait(1000, MSEC)\n\n\n# =========================\n# HELPERS\n# =========================\n\ndef normalize(value, min_v, max_v):\n\n    if max_v - min_v == 0:\n        return 0\n\n    return (value - min_v) / (max_v - min_v)\n\n\n# =========================\n# SENSOR VALUES\n# =========================\n\nX_REF = 0\nX_DIST = 0\nX_VAR = 0\n\n\n# =========================\n# SENSOR SCAN\n# =========================\n\ndef marblecheck():\n\n    global X_REF, X_DIST, X_VAR\n\n    # -------------------------\n    # REFLECTIVITY\n    # -------------------------\n\n    ref_total = 0\n    ref_samples = 10\n    ref_values = []\n\n    for _ in range(ref_samples):\n\n        val = line_tracker_b.reflectivity(PERCENT)\n\n        ref_values.append(val)\n        ref_total += val\n\n        wait(2, MSEC)\n\n    raw_ref = ref_total / ref_samples\n\n    # FIXED LIGHTING COMPENSATION\n    if BASE_REF > 0:\n        X_REF = (raw_ref / BASE_REF) * 100\n    else:\n        X_REF = raw_ref\n\n    # -------------------------\n    # VARIANCE\n    # -------------------------\n\n    X_VAR = max(ref_values) - min(ref_values)\n\n    # -------------------------\n    # DISTANCE\n    # -------------------------\n\n    dist_total = 0\n    valid_samples = 0\n\n    for _ in range(8):\n\n        dist = distance_1.object_distance(MM)\n\n        if dist > 0:\n\n            dist_total += dist\n            valid_samples += 1\n\n        wait(10, MSEC)\n\n    if valid_samples > 0:\n        X_DIST = dist_total / valid_samples\n    else:\n        X_DIST = 0\n\n\n# =========================\n# KNN CLASSIFIER\n# =========================\n\nclass KNNClassifier:\n\n    def __init__(self, k=5):\n\n        self.k = k\n        self.X_train = []\n        self.y_train = []\n\n    def fit(self, X, y):\n\n        self.X_train = X\n        self.y_train = y\n\n    def _distance(self, a, b):\n\n        REF_WEIGHT = 2.0\n        DIST_WEIGHT = 3.0\n        VAR_WEIGHT = .5\n\n        ref_diff = (a[0] - b[0]) * REF_WEIGHT\n        dist_diff = (a[1] - b[1]) * DIST_WEIGHT\n        var_diff = (a[2] - b[2]) * VAR_WEIGHT\n\n        return math.sqrt(\n            ref_diff ** 2 +\n            dist_diff ** 2 +\n            var_diff ** 2\n        )\n\n    def predict(self, X):\n\n        if isinstance(X[0], (int, float)):\n            X = [X]\n\n        predictions = []\n\n        for x in X:\n\n            distances = []\n\n            for i in range(len(self.X_train)):\n\n                dist = self._distance(x, self.X_train[i])\n                distances.append((dist, self.y_train[i]))\n\n            distances.sort(key=lambda p: p[0])\n\n            # Safety rejection\n\n            k_nearest = distances[:self.k]\n\n            counts = {}\n\n            for _, label in k_nearest:\n                counts[label] = counts.get(label, 0) + 1\n\n            predictions.append(max(counts, key=counts.get))\n\n        return predictions\n\n\n# =========================\n# TRAINING DATA\n# =========================\n\nraw_X_train = [\n\n    # SILVER\n    [80, 11, 11],\n    [85, 12, 11],\n    [90, 10, 12],\n    [92, 13, 10],\n    [95, 11, 12],\n    [82, 14, 11],\n    [87, 13, 12],\n    [97, 15, 13],\n    [93, 10, 10],\n    [88, 12, 13],\n\n    # WHITE\n    [105, 22, 4],\n    [108, 22, 5],\n    [110, 23, 4],\n    [112, 22, 5],\n    [115, 24, 4],\n    [103, 21, 5],\n    [118, 25, 4],\n    [120, 23, 6],\n    [101, 22, 5],\n    [122, 24, 4],\n\n    # WOOD\n    [96, 20, 3],\n    [93, 18.6, 2],\n    [95, 17, 5],\n    [107, 17.5, 2],\n    [88, 19.5, 3],\n    [112, 18, 1],\n    [91, 18, 4],\n    [92, 19, 2],\n    [94, 19, 3],\n    [109, 19, 2],\n]\n\ny_train = (\n    [\"Silver\"] * 10 +\n    [\"White\"] * 10 +\n    [\"Wood\"] * 10\n)\n\n\n# =========================\n# NORMALIZATION\n# =========================\n\nREF_MIN, REF_MAX = 50, 150\nDIST_MIN, DIST_MAX = 0, 35\nVAR_MIN, VAR_MAX = 0, 20\n\nX_train = []\n\nfor s in raw_X_train:\n\n    X_train.append([\n        normalize(s[0], REF_MIN, REF_MAX),\n        normalize(s[1], DIST_MIN, DIST_MAX),\n        normalize(s[2], VAR_MIN, VAR_MAX)\n    ])\n\n\n\nknn = KNNClassifier(k=5)\nknn.fit(X_train, y_train)\n\ncalibrate_light()\n\nSCAN_COUNT = 5\nvote_counts = {}\n\nfor _ in range(SCAN_COUNT):\n\n    marblecheck()\n\n    # BLACK FILTER\n    if X_DIST > 1000 or x distance_1 :\n\n        result = \"Black\"\n\n    else:\n\n        X_test = [\n            normalize(X_REF, REF_MIN, REF_MAX),\n            normalize(X_DIST, DIST_MIN, DIST_MAX),\n            normalize(X_VAR, VAR_MIN, VAR_MAX)\n        ]\n\n        prediction = knn.predict(X_test)[0]\n\n        # RULE OVERRIDES\n        result = prediction\n\n    vote_counts[result] = vote_counts.get(result, 0) + 1\n\n    wait(25, MSEC)\n\n\n# =========================\n# FINAL OUTPUT\n# =========================\n\nfinal_prediction = max(vote_counts, key=vote_counts.get)\nconfidence = int(\n    (vote_counts[final_prediction] / SCAN_COUNT) * 100\n)\n\nbrain.screen.clear_screen()\nbrain.screen.set_cursor(1, 1)\n\nbrain.screen.print(\"RAW REF:\")\nbrain.screen.print(round(X_REF, 1))\n\nbrain.screen.new_line()\n\nbrain.screen.print(\"DIST:\")\nbrain.screen.print(round(X_DIST, 1))\n\nbrain.screen.new_line()\n\nbrain.screen.print(\"VAR:\")\nbrain.screen.print(round(X_VAR, 1))\n\nbrain.screen.new_line()\n\nbrain.screen.print(\"TYPE:\")\nbrain.screen.print(final_prediction)\n\nbrain.screen.new_line()\n\nbrain.screen.print(\"CONF:\")\nbrain.screen.print(confidence)","textLanguage":"python","robotConfig":[{"port":[2],"name":"line_tracker_b","customName":false,"deviceType":"LineTracker","deviceClass":"line","setting":{},"triportSourcePort":22},{"port":[1],"name":"distance_1","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false}